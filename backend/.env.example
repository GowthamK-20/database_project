# ==============================================================================
# FINGUARD AI // ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Safe placeholder configuration — copy to .env and configure as needed.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PRIMARY DATABASE TARGET: Native PostgreSQL Connection String
# ------------------------------------------------------------------------------
# Set to your PostgreSQL credentials. If left commented out or invalid,
# the platform automatically falls back to embedded PGlite for zero-config evaluation.
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/finguard_db

# ------------------------------------------------------------------------------
# FALLBACK DATABASE TARGET: PGlite Custom Storage Directory (Optional)
# ------------------------------------------------------------------------------
# DATA_DIR=C:\Users\<YourUsername>\.veyra_pgdata

# Authentication Secret
JWT_SECRET=finguard_jwt_signing_secret_key_change_in_production
JWT_EXPIRES_IN=24h
